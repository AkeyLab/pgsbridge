Package: pgsbridge
Title: Intrinsic Transferability of Polygenic Scores Between Populations
Version: 1.0.0
Authors@R: c(
    person(given = "Kaiqian",
           family = "Zhang",
           role = c("aut", "cre", "cph"),
           email = "zhangkaiqian2025@gmail.com"),
    person(given = "John D.",
           family = "Storey",
