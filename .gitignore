# Figures and results written by the scripts
output/*
!output/.gitkeep

# Genotype files produced by the coalescent simulation. These are tens of
# gigabytes and are regenerated by simulation/01 and simulation/02.
genotypes/
*.vcf
*.vcf.gz
*.bed
*.bim
*.fam
*.nosex

# Cluster job output
*.out
slurm-*

# R session files
.Rhistory
.RData
.Rproj.user/

# Python
__pycache__/
*.pyc

# Default graphics device output, if a script opens one
Rplots.pdf
